# ===========================================================================
# DocSense — environment variables (EXAMPLE ONLY — copy to .env and fill in)
#   cp .env.example .env
# Never commit the real .env file (it is gitignored).
# ===========================================================================

# --- Server -----------------------------------------------------------------
PORT=8080
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed for CORS (the SPA origin)
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL + pgvector) --------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/doc_qa
DATABASE_USERNAME=docqa_app
DATABASE_PASSWORD=change-me

# Vector dimensionality — MUST match the embedding model output width actually
# stored. gemini-embedding-001 projects to this value via its `dimensions` option.
#   gemini-embedding-001 (dimensions=768) -> 768
EMBEDDING_DIMENSION=768

# --- Google OAuth2 (Google Cloud Console -> Credentials -> OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AI provider: gemini (real, default) or stub (offline deterministic stand-ins).
# The automated test suite runs with the `stub` provider and needs no key.
AI_PROVIDER=gemini

# --- Document processing / chunking ----------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=20MB
MAX_FILE_SIZE_BYTES=20971520
# Number of chunks retrieved into the RAG context
RAG_TOP_K=5

# --- Frontend build-time (Vite) --------------------------------------------
# In local dev these are UNUSED: the Vite dev server proxies /api, /oauth2 and
# /login to the backend, so relative defaults work. Only set them for a split
# deployment where the SPA and API live on different origins (e.g. Render).
# VITE_API_BASE_URL=https://<backend-host>/api
# VITE_BACKEND_URL=https://<backend-host>
